# Local development configuration.
# Copy to .env and adjust. Docker deployments use .env.docker.example instead.

NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/nexusflow

# At least 32 characters. A development fallback exists, but set your own.
JWT_ACCESS_SECRET=replace-with-a-long-random-development-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=info
RATE_LIMIT_ENABLED=true
REGISTRATION_ENABLED=true
TRUST_PROXY=false

# Used by `npm run seed` and by database bootstrap when provided.
SEED_SUPERADMIN_NAME=NexusFlow Admin
SEED_SUPERADMIN_EMAIL=admin@nexusflow.local
SEED_SUPERADMIN_PASSWORD=NexusFlow!Demo2026

# Retention windows (days).
TELEMETRY_RETENTION_DAYS=30
ROLLUP_1M_RETENTION_DAYS=90
ROLLUP_1H_RETENTION_DAYS=730

# Simulator limits.
SIM_MIN_INTERVAL_SEC=2
SIM_MAX_BACKFILL_POINTS=5000

# Hardware ingestion (disabled by default).
MQTT_ENABLED=false
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=nexusflow/v1

# Email (invitations and password resets are logged when SMTP is absent).
SMTP_HOST=
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=NexusFlow <no-reply@nexusflow.local>

# Actuators are permanently disabled by policy. Do not enable.
ACTUATORS_ENABLED=false
