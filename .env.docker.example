# Copy to .env.docker, then replace every placeholder before starting the stack.
#   docker compose --env-file .env.docker up -d --build

# --- MongoDB ---------------------------------------------------------------
MONGO_ROOT_USER=nexusflow
MONGO_ROOT_PASSWORD=replace-with-a-long-random-password

# --- API -------------------------------------------------------------------
APP_PORT=5000
CLIENT_ORIGIN=http://localhost:5000
# Must be at least 32 characters. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
LOG_LEVEL=info
RATE_LIMIT_ENABLED=true
REGISTRATION_ENABLED=true
TRUST_PROXY=false

# --- First administrator ---------------------------------------------------
# Create a password of at least 10 characters with upper, lower and numeric characters.
SEED_SUPERADMIN_NAME=NexusFlow Admin
SEED_SUPERADMIN_EMAIL=admin@example.com
SEED_SUPERADMIN_PASSWORD=replace-with-a-strong-initial-password

# --- Retention (days) ------------------------------------------------------
TELEMETRY_RETENTION_DAYS=30
ROLLUP_1M_RETENTION_DAYS=90
ROLLUP_1H_RETENTION_DAYS=730

# --- Optional MQTT hardware path ------------------------------------------
# Start the broker with: docker compose --env-file .env.docker --profile mqtt up -d
MQTT_ENABLED=false
MQTT_URL=mqtt://mqtt:1883
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=nexusflow/v1
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Optional SMTP ---------------------------------------------------------
SMTP_HOST=
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=NexusFlow <no-reply@nexusflow.local>
